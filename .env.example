# Supabase project URL and anon/public key (used for cookie-based sign-in).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret
BACKEND_API_URL=https://your-document-backend.example.com

# JSON map from authorized organization UUIDs to their backend API keys.
BACKEND_ORG_API_KEYS={"00000000-0000-4000-8000-000000000000":"replace-with-server-side-organization-api-key"}
